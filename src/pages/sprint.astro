{/* 🏎️ SCRIPTS DE TELEMETRÍA: Control de Bucle Infinito de Sprints */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('sprint-wrapper');
        const slides = document.querySelectorAll('.sprint-slide');
        const prevBtn = document.getElementById('prev-sprint-btn');
        const nextBtn = document.getElementById('next-sprint-btn');
        const dotsContainer = document.getElementById('sprint-dots');
        
        if (!wrapper || slides.length === 0) return;
        
        let currentIndex = 0; // Arranca en 0 (Última fecha del campeonato)
        const totalSlides = slides.length;

        // Generar puntitos dinámicos en mobile
        if(dotsContainer) {
            dotsContainer.innerHTML = '';
            slides.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-red-600 w-4' : 'bg-zinc-800'}`;
                dotsContainer.appendChild(dot);
            });
        }

        const updateSprintCarousel = () => {
            wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
            
            if(dotsContainer) {
                const dots = dotsContainer.querySelectorAll('div');
                dots.forEach((dot, i) => {
                    if(i === currentIndex) {
                        dot.className = 'w-2 h-2 rounded-full bg-red-600 w-4 transition-all duration-300';
                    } else {
                        dot.className = 'w-2 h-2 rounded-full bg-zinc-800 transition-all duration-300';
                    }
                });
            }
        };

        // Lógica de navegación cíclica (Permite ir a la izquierda desde la primera vista)
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = totalSlides - 1; // Salta a la carrera más vieja (bucle izquierdo)
                }
                updateSprintCarousel();
            });

            nextBtn.addEventListener('click', () => {
                if (currentIndex < totalSlides - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Vuelve al inicio reciente (bucle derecho)
                }
                updateSprintCarousel();
            });
        }

        // Deslizamiento táctil para celulares (Swipe)
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => startX = e.touches[0].clientX, {passive: true});
        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    if (currentIndex < totalSlides - 1) currentIndex++;
                    else currentIndex = 0;
                } else {
                    if (currentIndex > 0) currentIndex--;
                    else currentIndex = totalSlides - 1;
                }
                updateSprintCarousel();
            }
        }, {passive: true});
    });
</script>

    </main>
{/* 🏎️ CONTENEDOR PRINCIPAL DEL CARRETE DE IMÁGENES SPRINT */}
<section id="galeria-sprint" class="mt-20 pb-20 px-4 max-w-6xl mx-auto relative overflow-hidden">
    
    <div class="reveal-on-scroll text-center mb-16">
        <h2 class="text-sm font-black mb-4 uppercase tracking-[0.4em] text-zinc-400">
            Datos <span class="text-red-600">Sprint</span> Archivo
        </h2>
