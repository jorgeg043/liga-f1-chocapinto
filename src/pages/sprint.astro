                                <div class="w-2 h-2 bg-red-600 rounded-full animate-pulse"></div>
                                <h4 class="text-xs font-black uppercase tracking-widest text-zinc-300">
                                    SPRINT: <span class="text-white">FECHA {f}</span>
                                </h4>
                            </div>
                            <span class="text-[10px] font-mono text-zinc-600">TYPE: SPRINT_SESSION</span>
                        </div>

                        {/* Área Central (Imagen del Ticket de Resultados) */}
                        <div class="relative p-4 md:p-6 bg-zinc-900/20">
                            <div class="absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-red-600/50 z-20"></div>
                            <div class="absolute bottom-6 right-6 w-8 h-8 border-b-2 border-r-2 border-red-600/50 z-20"></div>

                            <div class="relative overflow-hidden rounded-lg bg-zinc-950/60 p-2 md:p-4 border border-zinc-800/30 flex flex-col items-center">
                                <img 
                                    src={`/Fotos/resultados-sprint-f${f}.jpg`} 
                                    class="w-full h-auto object-contain max-h-[75vh] filter drop-shadow-[0_0_20px_rgba(255,255,255,0.05)] transition-transform duration-700 group-hover:scale-[1.01]" 
                                    alt={`Resultados Sprint Fecha ${f}`}
                                    loading="lazy"
                                />
                                
                                {/* EFECTO DE ESCANEO LÁSER */}
                                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-red-600/[0.03] to-transparent h-[200%] w-full -translate-y-full group-hover:animate-[scan_4s_linear_infinite] pointer-events-none"></div>
                            </div>
                        </div>

                        {/* Footer de la Card */}
                        <div class="px-6 py-3 bg-zinc-950/80 text-right">
                            <p class="text-[9px] font-mono text-zinc-500 uppercase tracking-widest">
                                Sprint Data Verified // LC-VT-S{f}
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        ))}
    </div>

    {/* Indicadores inferiores para Mobile */}
    <div id="galeria-sprint-dots" class="flex justify-center gap-2 mt-6 md:hidden"></div>
</section>

{/* 🏎️ SCRIPTS DE TELEMETRÍA: Control de Transición de la Galería Sprint */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('galeria-sprint-wrapper');
        const slides = document.querySelectorAll('.galeria-sprint-slide');
        const prevBtn = document.getElementById('prev-galeria-sprint-btn');
        const nextBtn = document.getElementById('next-galeria-sprint-btn');
        const dotsContainer = document.getElementById('galeria-sprint-dots');
        
        if (!wrapper || slides.length === 0) return;
        
        let currentIndex = 0; // Arranca en la fecha más reciente (Índice 0)
        const totalSlides = slides.length;

        // Inyectar puntitos dinámicos para celulares
        if(dotsContainer) {
            dotsContainer.innerHTML = '';
            slides.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-red-600 w-4' : 'bg-zinc-800'}`;
                dotsContainer.appendChild(dot);
            });
        }

        const updateGaleriaSprintCarousel = () => {
            wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
            
            if(dotsContainer) {
                const dots = dotsContainer.querySelectorAll('div');
                dots.forEach((dot, i) => {
                    if(i === currentIndex) {
                        dot.className = 'w-2 h-2 rounded-full bg-red-600 w-4 transition-all duration-300';
                    } else {
                        dot.className = 'w-2 h-2 rounded-full bg-zinc-800 transition-all duration-300';
                    }
                });
            }
        };

        // Lógica de bucle infinito (Habilita ir a la izquierda de entrada)
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = totalSlides - 1; // Salta a la primera Sprint corrida
                }
                updateGaleriaSprintCarousel();
            });

            nextBtn.addEventListener('click', () => {
                if (currentIndex < totalSlides - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Regresa a la Sprint más reciente
                }
                updateGaleriaSprintCarousel();
            });
        }

        // Deslizamiento táctil para móviles (Swipe)
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => startX = e.touches[0].clientX, {passive: true});
        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    if (currentIndex < totalSlides - 1) currentIndex++;
                    else currentIndex = 0;
                } else {
                    if (currentIndex > 0) currentIndex--;
                    else currentIndex = totalSlides - 1;
                }
                updateGaleriaSprintCarousel();
            }
        }, {passive: true});
    });
</script>

<style>
    .vertical-text {
        writing-mode: vertical-rl;
    }

    @keyframes scan {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(200%); }
    }
</style>



<style>
    #typing-text {
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        /* Animación: escribir (4s), pausa, borrar, pausa */
        animation: typing 5s steps(30) infinite;
        width: 0;
        border-right: 3px solid transparent; /* Actúa como el cursor */
    }

    @keyframes typing {
        0% { width: 0; }
        30%, 70% { width: 100%; } /* Se queda escrito del 30% al 70% del tiempo */
        90%, 100% { width: 0; }    /* Se borra al final */
    }

    .animate-cursor {
        animation: blink 0.8s step-end infinite;
    }

    @keyframes blink {
        from, to { opacity: 1; }
        50% { opacity: 0; }
    }
</style>
