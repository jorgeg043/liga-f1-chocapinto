            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    {/* Riel Horizontal Deslizable */}
    <div id="galeria-sprint-wrapper" class="flex transition-transform duration-500 ease-out w-full">
        {/* Ordenamos de mayor a menor para garantizar que la fecha más nueva sea el índice 0 */}
        {[...fechasSprint].sort((a, b) => b - a).map((f) => (
            <div class="w-full flex-shrink-0 px-1 md:px-14 galeria-sprint-slide">
                <div class="reveal-item group relative" style={`transition-delay: 100ms;`}>
                    
                    {/* Indicador de número técnico lateral izquierdo */}
                    <div class="absolute -left-2 md:-left-12 top-0 flex flex-col items-center z-10">
                        <span class="text-[10px] font-black text-zinc-600 uppercase tracking-[0.5em] rotate-180" style="writing-mode: vertical-rl;">
                            FAST_TRACK
                        </span>
                        <div class="w-[1px] h-14 md:w-[1px] md:h-20 bg-zinc-800 my-2 md:my-4"></div>
                        <span class="text-xl md:text-2xl font-mono font-black text-red-600 italic">
                            S{f < 10 ? `0${f}` : f}
                        </span>
                    </div>

                    {/* Contenedor Principal HUD */}
                    <div class="ml-8 md:ml-0 bg-[#020c1b]/50 border border-zinc-900 rounded-xl overflow-hidden hover:border-red-600/30 transition-all duration-500 shadow-2xl">
                        
                        {/* Header de la Card */}
