<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        // --- 1. REFERENCIAS PRINCIPALES ---
        const splash = document.getElementById('splash-screen');
        const f1Text = [document.getElementById('splash-f'), document.getElementById('splash-1')];
        const ligaText = document.getElementById('splash-liga');
        const lines = [
            document.getElementById('line-t'), document.getElementById('line-r'),
            document.getElementById('line-b'), document.getElementById('line-l')
        ];
        
        const musica = document.getElementById('musica-fondo');
        const btnMusica = document.getElementById('btn-musica');
        const btnHistorial = document.getElementById('btn-historial');
        const menuHistorial = document.getElementById('menu-historial');
        const flechaHistorial = document.getElementById('flecha-historial');

        if (!splash) return;

        // --- 2. VERIFICACIÓN DE SESIÓN (EVITA TRABAS) ---
        const esHome = window.location.pathname === '/' || window.location.pathname === '/index.html';
        const yaVisto = sessionStorage.getItem('splash-visto');

        if (!esHome || yaVisto) {
            splash.style.display = 'none';
            document.body.classList.remove('overflow-hidden');
        } else {
            // --- 3. SECUENCIA DE ANIMACIÓN UNIFICADA (PRIMERA VISTA) ---
            splash.style.display = 'flex';
            document.body.classList.add('overflow-hidden');

            // Entrada de "F1 2026" (Clases de Tailwind + Estilos Limpios)
            setTimeout(() => {
                const f = f1Text[0];
                const n1 = f1Text[1];
                if (f && n1) {
                    f.classList.remove('translate-x-[-100%]', 'opacity-0');
                    f.classList.add('translate-x-0', 'opacity-100', 'f1-glow');
                    n1.classList.remove('translate-x-[100%]', 'opacity-0');
                    n1.classList.add('translate-x-0', 'opacity-100', 'f1-glow');
                }
            }, 300);

            // Entrada de "BIENVENIDOS"
            setTimeout(() => {
                if (ligaText) {
                    ligaText.classList.remove('opacity-0', 'translate-y-[20px]');
                    ligaText.classList.add('opacity-100', 'translate-y-0');
                }
            }, 1000);

            // Dibujado de las líneas HUD perimetrales
            setTimeout(() => {
                if (lines[0]) lines[0].classList.add('draw-line-h');
                setTimeout(() => { if (lines[1]) lines[1].classList.add('draw-line-v') }, 100);
                setTimeout(() => { if (lines[2]) lines[2].classList.add('draw-line-h') }, 200);
                setTimeout(() => { if (lines[3]) lines[3].classList.add('draw-line-v') }, 300);
            }, 1600);

            // Cierre definitivo del Splash
            setTimeout(() => {
                splash.style.opacity = '0';
                document.body.classList.remove('overflow-hidden');
                
                setTimeout(() => {
                    splash.style.display = 'none';
                    sessionStorage.setItem('splash-visto', 'true');
                }, 1000);
            }, 3600);
        }

        // --- 4. LÓGICA DEL BOTÓN DE MÚSICA (PLAY/PAUSE) ---
        if (btnMusica && musica) {
            btnMusica.replaceWith(btnMusica.cloneNode(true));
            const nuevoBtnMusica = document.getElementById('btn-musica');

            nuevoBtnMusica.addEventListener('click', () => {
                if (musica.paused) {
                    musica.play();
                    nuevoBtnMusica.classList.add('playing');
                } else {
                    musica.pause();
                    nuevoBtnMusica.classList.remove('playing');
                }
            });
        }

        // --- 5. DROPDOWN HISTORIAL ---
        if (btnHistorial && menuHistorial && flechaHistorial) {
            btnHistorial.addEventListener('click', (e) => {
                if (window.innerWidth < 1024) {
                    e.preventDefault();
                    e.stopPropagation();
                    menuHistorial.classList.toggle('show-dropdown');
                    flechaHistorial.classList.toggle('rotate-arrow');
                }
            });
        }

        // --- 6. REVEAL ON SCROLL ---
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-on-scroll, .reveal-item').forEach(el => observer.observe(el));
    });
</script>
<script>
  document.addEventListener('astro:page-load', () => {
    // Esperamos los 100ms a que el carrusel se acomode en el DOM
    setTimeout(() => {
      // 1. Buscamos con tu clase exacta: "lazy-video"
      const lazyVideos = document.querySelectorAll('video.lazy-video');
      
      if (lazyVideos.length === 0) return;

      if ('IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const video = entry.target;
              if (video.dataset.src) {
                video.src = video.dataset.src;
                video.load(); 
              }
              // 2. Le removemos tu clase para que no lo vuelva a evaluar
              video.classList.remove('lazy-video');
              videoObserver.unobserve(video);
            }
          });
        });

        lazyVideos.forEach((video) => videoObserver.observe(video));
      } else {
        // Fallback tradicional
        lazyVideos.forEach((video) => {
          if (video.dataset.src) video.src = video.dataset.src;
        });
      }
    }, 100); 
  });
</script>



