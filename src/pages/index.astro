                                                        {race.circuito}
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="flex flex-col items-end font-mono text-[9px]">
                                                {estadoCalculado === 'finished' && <span class="text-[6.5px] font-black text-zinc-600 border border-zinc-900 bg-black/40 px-1.5 py-0.5 rounded uppercase tracking-widest">DONE</span>}
                                                {estadoCalculado === 'next' && <span class="flex items-center gap-1 text-[7.5px] font-black text-red-500 uppercase tracking-widest bg-red-950/20 border border-red-900/50 px-1.5 py-0.5 rounded animate-pulse">NEXT</span>}
                                                {estadoCalculado === 'upcoming' && <span class="text-[6.5px] font-black text-zinc-500 border border-zinc-900/60 bg-zinc-900/10 px-1.5 py-0.5 rounded uppercase tracking-widest">STDBY</span>}
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
            ))}

        </div>
    </div>
