{/* 🏎️ ENGINE DE SELECCIÓN Y PROYECCIÓN 3D PARA MONOPLAZAS */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const cards = document.querySelectorAll('.monoplaza-card');
        if (cards.length === 0) return;

        let activeIndex = 0; // Arranca el primer coche enfocado (Alpine)
        const totalCards = cards.length;
        let autoPlayInterval = null;
        const AUTO_PLAY_SPEED = 6000; // Avanza de coche solo cada 6 segundos

        const render3DMonoplazas = () => {
            const isMobile = window.innerWidth < 768;

            cards.forEach((card, index) => {
                // Aritmética modular para calcular la distancia en un bucle infinito real de 7 elementos
                let offset = index - activeIndex;
                if (offset < -Math.floor(totalCards / 2)) offset += totalCards;
                if (offset > Math.floor(totalCards / 2)) offset -= totalCards;

                if (offset === 0) {
                    // 🎯 MONOPLAZA CENTRAL (Enfoque principal al frente)
                    card.style.transform = `translateX(0px) translateZ(120px) rotateY(0deg) scale(1)`;
                    card.style.zIndex = '30';
                    card.style.opacity = '1';
                    card.style.filter = 'blur(0px) brightness(1)';
                    card.style.pointerEvents = 'auto';
                } else if (offset === -1) {
                    // 👈 MONOPLAZA IZQUIERDO INMEDIATO
                    const xShift = isMobile ? '-50px' : '-320px';
                    const zShift = isMobile ? '-100px' : '-200px';
                    const yRot = isMobile ? '20deg' : '40deg';

                    card.style.transform = `translateX(${xShift}) translateZ(${zShift}) rotateY(${yRot}) scale(0.85)`;
                    card.style.zIndex = '20';
                    card.style.opacity = isMobile ? '0.25' : '0.5';
                    card.style.filter = 'blur(3px) brightness(0.4)';
                    card.style.pointerEvents = 'auto';
                } else if (offset === 1) {
                    // 👉 MONOPLAZA DERECHO INMEDIATO
                    const xShift = isMobile ? '50px' : '320px';
                    const zShift = isMobile ? '-100px' : '-200px';
                    const yRot = isMobile ? '-20deg' : '-40deg';

                    card.style.transform = `translateX(${xShift}) translateZ(${zShift}) rotateY(${yRot}) scale(0.85)`;
                    card.style.zIndex = '20';
                    card.style.opacity = isMobile ? '0.25' : '0.5';
                    card.style.filter = 'blur(3px) brightness(0.4)';
                    card.style.pointerEvents = 'auto';
                } else {
                    // 🕶️ RESTO DE MONOPLAZAS OCULTOS EN LA PARTE TRASERA DEL BUCLE
                    // Se desplazan de forma invisible listos para rotar al frente
                    const direction = offset > 0 ? 1 : -1;
                    const xShift = isMobile ? `${direction * 100}px` : `${direction * 500}px`;
                    card.style.transform = `translateX(${xShift}) translateZ(-350px) rotateY(${direction * -60}deg) scale(0.6)`;
                    card.style.zIndex = '10';
                    card.style.opacity = '0';
                    card.style.pointerEvents = 'none';
                }
            });
        };

        const nextCard = () => {
            activeIndex = (activeIndex + 1) % totalCards;
            render3DMonoplazas();
        };

        // Evento de clic directo: si tocás un coche de los costados, vuela al frente al instante
        cards.forEach((card, index) => {
            card.addEventListener('click', () => {
                if (activeIndex !== index) {
                    activeIndex = index;
                    render3DMonoplazas();
                    resetAutoPlay();
                }
            });
        });

        // Controles de Automatización Cíclica
        const startAutoPlay = () => {
            if (autoPlayInterval === null) {
                autoPlayInterval = setInterval(nextCard, AUTO_PLAY_SPEED);
            }
        };

        const stopAutoPlay = () => {
            if (autoPlayInterval !== null) {
                clearInterval(autoPlayInterval);
                autoPlayInterval = null;
            }
        };

        const resetAutoPlay = () => {
            stopAutoPlay();
            startAutoPlay();
        };

        // Pausa inteligente por hover en toda la sección (para poder ver los videos en detalle)
        const container = document.getElementById('pilotos');
        if (container) {
            container.addEventListener('mouseenter', stopAutoPlay);
            container.addEventListener('mouseleave', startAutoPlay);
        }

        // Soporte táctil con deslizamiento para smartphones
        let startX = 0;
        container?.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            stopAutoPlay();
        }, {passive: true});

        container?.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) activeIndex = (activeIndex + 1) % totalCards;
                else activeIndex = (activeIndex - 1 + totalCards) % totalCards;
                render3DMonoplazas();
            }
            startAutoPlay();
        }, {passive: true});

        // Recalcular offsets si cambia el tamaño de pantalla (para responsive)
        window.addEventListener('resize', render3DMonoplazas);

        // Arranque en pista
        render3DMonoplazas();
        startAutoPlay();
    });
</script>






