{/* 🏎️ MOTOR DEL CARRUSEL DE MESTREO INTEGRANTES (AUTOPLAY 2,5 SEGUNDOS) */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('integrantes-wrapper');
        const slides = document.querySelectorAll('.integrantes-slide');
        const prevBtn = document.getElementById('prev-integrantes-btn');
        const nextBtn = document.getElementById('next-integrantes-btn');
        const dotsContainer = document.getElementById('integrantes-dots');

        if (!wrapper || slides.length === 0) return;

        let currentIndex = 0;
        const totalSlides = slides.length;
        let autoPlayTimer = null;
        const AUTO_PLAY_SPEED = 2500; // ⏱️ Movimiento automático cada 2 segundos exactos

        const getSlidesPerView = () => {
            if (window.innerWidth >= 1024) return 3;
            if (window.innerWidth >= 640) return 2;
            return 1;
        };

        const updateDots = () => {
            if (!dotsContainer) return;
            dotsContainer.innerHTML = '';
            const maxVisibleDots = totalSlides - getSlidesPerView() + 1;
            
            for (let i = 0; i < Math.max(maxVisibleDots, 1); i++) {
                const dot = document.createElement('div');
                dot.className = `h-1.5 rounded-full transition-all duration-300 cursor-pointer ${i === currentIndex ? 'bg-red-600 w-5' : 'bg-zinc-800 w-1.5'}`;
                dot.addEventListener('click', () => {
                    currentIndex = i;
                    moveCarousel();
                    resetAutoPlay();
                });
                dotsContainer.appendChild(dot);
            }
        };

        const moveCarousel = () => {
            const slidesPerView = getSlidesPerView();
            const maxIndex = totalSlides - slidesPerView;

            if (currentIndex > maxIndex) currentIndex = maxIndex;
            if (currentIndex < 0) currentIndex = 0;

            const slideWidth = slides[0].getBoundingClientRect().width;
            wrapper.style.transform = `translateX(-${currentIndex * slideWidth}px)`;
            updateDots();
        };

        const nextSlide = () => {
            const maxIndex = totalSlides - getSlidesPerView();
            if (currentIndex < maxIndex) {
                currentIndex++;
            } else {
                currentIndex = 0; // Bucle infinito inicial
            }
            moveCarousel();
        };

        const prevSlide = () => {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = totalSlides - getSlidesPerView(); // Bucle infinito final
            }
            moveCarousel();
        };

        // MOTOR DE MOVIMIENTO AUTÓNOMO
        const startAutoPlay = () => {
            if (autoPlayTimer === null) {
                autoPlayTimer = setInterval(nextSlide, AUTO_PLAY_SPEED);
            }
        };

        const stopAutoPlay = () => {
            if (autoPlayTimer !== null) {
                clearInterval(autoPlayTimer);
                autoPlayTimer = null;
            }
        };

        const resetAutoPlay = () => {
            stopAutoPlay();
            startAutoPlay();
        };

        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                prevSlide();
                resetAutoPlay();
            });

            nextBtn.addEventListener('click', () => {
                nextSlide();
                resetAutoPlay();
            });
        }

        // Swipe táctil en pantallas celulares
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            stopAutoPlay();
        }, {passive: true});

        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) nextSlide();
                else prevSlide();
            }
            startAutoPlay();
        }, {passive: true});

        // Congelar credencial al pasar el cursor encima (Pausa inteligente para leer redes o hardware)
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);

        window.addEventListener('resize', () => {
            moveCarousel();
            resetAutoPlay();
        });

        // Semáforo en verde
        moveCarousel();
        startAutoPlay();
    });
</script>

