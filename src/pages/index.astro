{/* 🏎️ ENGINE DE ROTACIÓN Y PERSPECTIVA 3D INFINITA */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const cards = document.querySelectorAll('.config-card');
        if (cards.length === 0) return;

        let activeIndex = 1; // Arranca por defecto la tarjeta del medio (Asistencias)
        const totalCards = cards.length;
        let autoPlayInterval = null;
        const ROTATION_SPEED = 5000; // Avanza sola cada 5 segundos

        const render3DCarousel = () => {
            const isMobile = window.innerWidth < 768;

            cards.forEach((card, index) => {
                // Cálculo de la distancia relativa con aritmética circular infinita
                let offset = index - activeIndex;
                if (offset < -1) offset += totalCards;
                if (offset > 1) offset -= totalCards;

                if (offset === 0) {
                    // 📌 TARJETA EN EL CENTRO (Enfoque principal)
                    card.style.transform = `translateX(0px) translateZ(100px) rotateY(0deg) scale(1)`;
                    card.style.zIndex = '20';
                    card.style.opacity = '1';
                    card.style.filter = 'blur(0px) brightness(1)';
                    card.style.pointerEvents = 'auto';
                } else if (offset === -1 || (offset === totalCards - 1)) {
                    // 👈 TARJETA IZQUIERDA (Retrasada y rotada)
                    const xShift = isMobile ? '-40px' : '-280px';
                    const zShift = isMobile ? '-120px' : '-180px';
                    const yRot = isMobile ? '25deg' : '45deg';
                    
                    card.style.transform = `translateX(${xShift}) translateZ(${zShift}) rotateY(${yRot}) scale(0.9)`;
                    card.style.zIndex = '10';
                    card.style.opacity = isMobile ? '0.3' : '0.6';
                    card.style.filter = 'blur(2px) brightness(0.5)';
                    card.style.pointerEvents = 'auto';
                } else if (offset === 1 || (offset === -totalCards + 1)) {
                    // 👉 TARJETA DERECHA (Retrasada y rotada invertida)
                    const xShift = isMobile ? '40px' : '280px';
                    const zShift = isMobile ? '-120px' : '-180px';
                    const yRot = isMobile ? '-25deg' : '-45deg';

                    card.style.transform = `translateX(${xShift}) translateZ(${zShift}) rotateY(${yRot}) scale(0.9)`;
                    card.style.zIndex = '10';
                    card.style.opacity = isMobile ? '0.3' : '0.6';
                    card.style.filter = 'blur(2px) brightness(0.5)';
                    card.style.pointerEvents = 'auto';
                } else {
                    // Tarjetas fantasma ocultas por resguardo
                    card.style.transform = `translateX(0px) translateZ(-300px) rotateY(0deg)`;
                    card.style.zIndex = '0';
                    card.style.opacity = '0';
                    card.style.pointerEvents = 'none';
                }
            });
        };

        const nextCard = () => {
            activeIndex = (activeIndex + 1) % totalCards;
            render3DCarousel();
        };

        // Asignar el click directo sobre las tarjetas laterales para traerlas al frente
        cards.forEach((card, index) => {
            card.addEventListener('click', () => {
                if (activeIndex !== index) {
                    activeIndex = index;
                    render3DCarousel();
                    resetAutoPlay();
                }
            });
        });

        // Controles de temporizador autónomo
        const startAutoPlay = () => {
            if (autoPlayInterval === null) {
                autoPlayInterval = setInterval(nextCard, ROTATION_SPEED);
            }
        };

        const stopAutoPlay = () => {
            if (autoPlayInterval !== null) {
                clearInterval(autoPlayInterval);
                autoPlayInterval = null;
            }
        };

        const resetAutoPlay = () => {
            stopAutoPlay();
            startAutoPlay();
        };

        // Pausa por hover en monitores para poder auditar los reglamentos
        const container = document.getElementById('Configuración');
        if (container) {
            container.addEventListener('mouseenter', stopAutoPlay);
            container.addEventListener('mouseleave', startAutoPlay);
        }

        // Swipe táctil para celulares
        let startX = 0;
        container?.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            stopAutoPlay();
        }, {passive: true});

        container?.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) activeIndex = (activeIndex + 1) % totalCards;
                else activeIndex = (activeIndex - 1 + totalCards) % totalCards;
                render3DCarousel();
            }
            startAutoPlay();
        }, {passive: true});

        window.addEventListener('resize', render3DCarousel);

        // Inicialización en pista
        render3DCarousel();
        startAutoPlay();
    });
</script>

<style>
    /* Efecto de aparición al scrollear */
    .reveal-on-scroll {
        opacity: 0;
