{/* 🏎️ ENGINE ACTUALIZADO: MOVIMIENTO AUTOMÁTICO + CONTROL MANUAL INFINITO */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('constructores-clean-wrapper');
        const slides = document.querySelectorAll('.constructores-clean-slide');
        const prevBtn = document.getElementById('prev-constructores-clean-btn');
        const nextBtn = document.getElementById('next-constructores-clean-btn');
        const dotsContainer = document.getElementById('constructores-clean-dots');

        if (!wrapper || slides.length === 0) return;

        let currentIndex = 0;
        const totalSlides = slides.length;
        let autoPlayTimer = null;
        const AUTO_PLAY_SPEED = 2000; // ⏱️ Se desplaza solo cada 4 segundos

        const getSlidesPerView = () => {
            if (window.innerWidth >= 1024) return 3;
            if (window.innerWidth >= 640) return 2;
            return 1;
        };

        const updateDots = () => {
            if (!dotsContainer) return;
            dotsContainer.innerHTML = '';
            const maxVisibleDots = totalSlides - getSlidesPerView() + 1;
            
            for (let i = 0; i < Math.max(maxVisibleDots, 1); i++) {
                const dot = document.createElement('div');
                dot.className = `h-1.5 rounded-full transition-all duration-300 cursor-pointer ${i === currentIndex ? 'bg-red-600 w-5' : 'bg-zinc-800 w-1.5'}`;
                dot.addEventListener('click', () => {
                    currentIndex = i;
                    moveCarousel();
                    resetAutoPlay(); // Si el usuario interactúa, reinicia el reloj
                });
                dotsContainer.appendChild(dot);
            }
        };

        const moveCarousel = () => {
            const slidesPerView = getSlidesPerView();
            const maxIndex = totalSlides - slidesPerView;

            if (currentIndex > maxIndex) currentIndex = maxIndex;
            if (currentIndex < 0) currentIndex = 0;

            const slideWidth = slides[0].getBoundingClientRect().width;
            wrapper.style.transform = `translateX(-${currentIndex * slideWidth}px)`;
            updateDots();
        };

        // Avanzar al siguiente (Lógica unificada para botón y Autoplay)
        const nextSlide = () => {
            const maxIndex = totalSlides - getSlidesPerView();
            if (currentIndex < maxIndex) {
                currentIndex++;
            } else {
                currentIndex = 0; // Regresa al inicio de forma infinita
            }
            moveCarousel();
        };

        const prevSlide = () => {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = totalSlides - getSlidesPerView(); // Salta al final de forma infinita
            }
            moveCarousel();
        };

        // 🛠️ MOTOR DE AUTOPLAY
        const startAutoPlay = () => {
            if (autoPlayTimer === null) {
                autoPlayTimer = setInterval(nextSlide, AUTO_PLAY_SPEED);
            }
        };

        const stopAutoPlay = () => {
            if (autoPlayTimer !== null) {
                clearInterval(autoPlayTimer);
                autoPlayTimer = null;
            }
        };

        const resetAutoPlay = () => {
            stopAutoPlay();
            startAutoPlay();
        };

        // Escuchadores manuales con reseteo de tiempo
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                prevSlide();
                resetAutoPlay();
            });

            nextBtn.addEventListener('click', () => {
                nextSlide();
                resetAutoPlay();
            });
        }

        // Gestos táctiles en celulares
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            stopAutoPlay(); // Pausa el autoplay mientras arrastran el dedo
        }, {passive: true});

        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) nextSlide();
                else prevSlide();
            }
            startAutoPlay(); // Reanuda el autoplay al soltar
        }, {passive: true});

        // 🛑 PAUSA INTELIGENTE EN ESCRITORIO
        // Si el usuario pasa el cursor por encima de la sección, se congela para que pueda mirar tranquilo
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);

        window.addEventListener('resize', () => {
            moveCarousel();
            resetAutoPlay();
        });

        // Disparo Inicial
        moveCarousel();
        startAutoPlay();
    });
</script>

