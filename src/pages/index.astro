<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. VIDEOS PRINCIPALES: Carga prioritaria inmediata
    const priorityIds = ["video-intro", "Baku"];
    
    priorityIds.forEach(id => {
      const video = document.getElementById(id) as HTMLVideoElement; // TypeScript fix para Astro
      if (video && video.dataset.src) {
        video.src = video.dataset.src;
        video.load();
      }
    });

    // 2. RESTO DE VIDEOS: Lazy loading por scroll
    const lazyVideos = document.querySelectorAll("video.lazy-video:not(#video-intro):not(#Baku)");

    if ("IntersectionObserver" in window && lazyVideos.length > 0) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((video) => {
          if (video.isIntersecting) {
            const videoTarget = video.target as HTMLVideoElement;
            videoTarget.src = videoTarget.dataset.src || "";
            videoTarget.load();
            videoObserver.unobserve(videoTarget);
          }
        });
      });

      lazyVideos.forEach((video) => videoObserver.observe(video));
    }
  });
</script>



