        <h2 class="text-sm font-black mb-12 uppercase tracking-[0.4em] text-white flex items-center gap-4">
            <span class="flex-1 h-[1px] bg-zinc-800"></span> 
            <span class="text-white italic">CAMPEONATO</span> PILOTOS
            <span class="flex-1 h-[1px] bg-zinc-800"></span>
        </h2>
    </div>

    <div class="bg-zinc-950/50 backdrop-blur-md rounded-xl overflow-hidden border border-zinc-900 shadow-2xl">
        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead class="bg-zinc-900/80 border-b border-zinc-800">
                    <tr class="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500">
                        <th class="px-6 py-5 text-center w-20">Posición</th>
                        <th class="px-6 py-5">Info Piloto</th>
                        <th class="px-4 py-5 text-center text-yellow-600">Victorias</th>
                        <th class="px-4 py-5 text-center text-red-600">Poles</th>
                        <th class="px-4 py-5 text-center text-blue-500">Vuelta Rápida</th>
                        <th class="px-8 py-5 text-right text-white">Total Pts</th>
                    </tr>
                </thead>

               <tbody class="divide-y divide-zinc-900">
    {/* 🏎️ Mantenemos tus filtros y ordenamientos deportivos intactos */}
    {(() => {
        const pilotosFiltrados = pilotos
            .filter(p => p.activo !== false)
            .sort((a, b) => b.puntos - a.puntos);

        return pilotosFiltrados.map((piloto, index) => {
            // 🛠️ SECCIÓN 1: PODIO PREMIUM CON TELEMETRÍA COMPLETA (Victorias, Poles, V.R.)
            if (index === 0) {
                const top3 = pilotosFiltrados.slice(0, 3);
                
                const podioOrdenado = [
                    top3[1], // P2 (Plata) - Izquierda
                    top3[0], // P1 (Oro) - Centro
                    top3[2]  // P3 (Bronce) - Derecha
                ].filter(Boolean);

                return (
                    <tr class="bg-zinc-950/40">
                        <td colspan="6" class="px-6 py-10">
                            <!-- Contenedor Grid del Podio HUD -->
                            <div class="grid grid-cols-3 items-end gap-3 max-w-3xl mx-auto font-mono text-center">
                                {podioOrdenado.map((p) => {
                                    const posReal = pilotosFiltrados.findIndex(orig => orig.nombre === p.nombre) + 1;
                                    
                                    const esP1 = posReal === 1;
                                    const esP2 = posReal === 2;
                                    
                                    let borderColor = 'border-amber-600';
                                    let glowColor = 'shadow-[0_0_20px_rgba(180,83,9,0.15)]';
                                    let metalBg = 'bg-amber-700/10';
                                    let textMetal = 'text-amber-600';
                                    let alturaBox = 'h-56'; // Ampliamos la altura para acomodar las estadísticas

                                    if (esP1) {
                                        borderColor = 'border-yellow-500';
                                        glowColor = 'shadow-[0_0_35px_rgba(234,179,8,0.25)]';
                                        metalBg = 'bg-yellow-500/10';
                                        textMetal = 'text-yellow-500 animate-pulse';
                                        alturaBox = 'h-68'; 
                                    } else if (esP2) {
                                        borderColor = 'border-zinc-400';
                                        glowColor = 'shadow-[0_0_20px_rgba(161,161,170,0.15)]';
                                        metalBg = 'bg-zinc-500/10';
                                        textMetal = 'text-zinc-400';
                                        alturaBox = 'h-60';
                                    }

                                    return (
                                        <div class="flex flex-col items-center group/podio transition-all duration-500 hover:-translate-y-1">
                                            {/* Avatar Flotante */}
                                            <div class="relative mb-2">
                                                <img 
    src={`/Fotos/perfil-${p.nombre.toLowerCase()}.jpg`} 
    alt={p.nombre} 
    class={`rounded-full object-cover border-2 ${borderColor} ${glowColor} transition-all duration-500 z-10 relative ${esP1 ? 'w-24 h-24 md:w-32 md:h-32' : 'w-20 h-20 md:w-24 md:h-24'}`}
/>
                                                <div class={`absolute inset-0 rounded-full blur-md opacity-0 group-hover/podio:opacity-100 transition-opacity ${esP1 ? 'bg-yellow-500/20' : esP2 ? 'bg-zinc-400/20' : 'bg-amber-600/20'}`}></div>
                                            </div>

                                            {/* Datos del Piloto */}
                                            <h4 class="font-black text-white text-xs md:text-sm uppercase tracking-tighter italic leading-none truncate max-w-full px-1">
                                                {p.nombre}
                                            </h4>
                                            <span class="text-[8px] text-zinc-600 uppercase tracking-wider mt-0.5 mb-3 group-hover/podio:text-zinc-400 transition-colors">
                                                {p.escuderia}
                                            </span>

                                            {/* Estructura del Cajón del Podio */}
