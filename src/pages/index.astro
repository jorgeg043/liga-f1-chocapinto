{/* 🏎️ ENGINE INTEGRADO: PROGRESO SEGURO + CARRETE DE MESES (AUTOPLAY 4 SEGUNDOS) */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        // 1. Motor de Animación de la Barra de Progreso
        const progressBar = document.getElementById('season-progress-bar');
        if (progressBar) {
            const target = progressBar.getAttribute('data-progress');
            progressBar.style.width = '0%';
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    progressBar.style.width = target + '%';
                });
            });
        }

        // 2. Motor del Carrusel de Meses
        const wrapper = document.getElementById('calendario-wrapper');
        const slides = document.querySelectorAll('.calendario-slide');
        const prevBtn = document.getElementById('prev-calendario-btn');
        const nextBtn = document.getElementById('next-calendario-btn');

        if (!wrapper || slides.length === 0) return;

        let currentIndex = 0;
        const totalSlides = slides.length;
        let autoPlayTimer = null;
        const AUTO_PLAY_SPEED = 2000; // Se mueve solo de mes cada 2 segundos

        const getSlidesPerView = () => {
            if (window.innerWidth >= 1024) return 3; // 3 meses en monitores
            if (window.innerWidth >= 640) return 2;  // 2 meses en tablets
            return 1;                                // 1 mes en celulares
        };

        const moveCarousel = () => {
            const slidesPerView = getSlidesPerView();
            const maxIndex = totalSlides - slidesPerView;

            if (currentIndex > maxIndex) currentIndex = maxIndex;
            if (currentIndex < 0) currentIndex = 0;

            const slideWidth = slides[0].getBoundingClientRect().width;
            wrapper.style.transform = `translateX(-${currentIndex * slideWidth}px)`;
        };

        const nextSlide = () => {
            const maxIndex = totalSlides - getSlidesPerView();
            if (currentIndex < maxIndex) {
                currentIndex++;
            } else {
                currentIndex = 0; // Bucle infinito al inicio
            }
            moveCarousel();
        };

        const prevSlide = () => {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = totalSlides - getSlidesPerView(); // Bucle infinito al final
            }
            moveCarousel();
        };

        const startAutoPlay = () => {
            if (autoPlayTimer === null) {
                autoPlayTimer = setInterval(nextSlide, AUTO_PLAY_SPEED);
            }
        };

        const stopAutoPlay = () => {
            if (autoPlayTimer !== null) {
                clearInterval(autoPlayTimer);
                autoPlayTimer = null;
            }
        };

        const resetAutoPlay = () => {
            stopAutoPlay();
            startAutoPlay();
        };

        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => { prevSlide(); resetAutoPlay(); });
            nextBtn.addEventListener('click', () => { nextSlide(); resetAutoPlay(); });
        }

        // Gestos touch celulares
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; stopAutoPlay(); }, {passive: true});
        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            if (Math.abs(startX - endX) > 50) {
                if (startX - endX > 0) nextSlide();
                else prevSlide();
            }
            startAutoPlay();
        }, {passive: true});

        // Pausa inteligente al pasar el cursor (frena el carrusel para auditar circuitos)
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);

        window.addEventListener('resize', () => { moveCarousel(); resetAutoPlay(); });

        startAutoPlay();
    });
</script>

