{/* 🏎️ TELEMETRÍA SCRIPT: Lógica de transición de slides */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('carreras-wrapper');
        const slides = document.querySelectorAll('.carrera-slide');
        const prevBtn = document.getElementById('prev-carrera-btn');
        const nextBtn = document.getElementById('next-carrera-btn');
        const dotsContainer = document.getElementById('carousel-dots');
        
        if (!wrapper || slides.length === 0) return;
        
        let currentIndex = 0;
        const totalSlides = slides.length;

        // Generar puntitos dinámicos en mobile
        if(dotsContainer) {
            dotsContainer.innerHTML = '';
            slides.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-red-600 w-4' : 'bg-zinc-800'}`;
                dot.setAttribute('data-index', i);
                dotsContainer.appendChild(dot);
            });
        }

        const updateCarousel = () => {
            // Movemos el flex rail basándonos en el porcentaje del índice actual
            wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
            
            // Actualizar puntitos en mobile
            if(dotsContainer) {
                const dots = dotsContainer.querySelectorAll('div');
                dots.forEach((dot, i) => {
                    if(i === currentIndex) {
                        dot.className = 'w-2 h-2 rounded-full bg-red-600 w-4 transition-all duration-300';
                    } else {
                        dot.className = 'w-2 h-2 rounded-full bg-zinc-800 transition-all duration-300';
                    }
                });
            }
        };

        // Eventos de botones
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = totalSlides - 1; // Hace loop al último
                }
                updateCarousel();
            });

            nextBtn.addEventListener('click', () => {
                if (currentIndex < totalSlides - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Hace loop al primero
                }
                updateCarousel();
            });
        }

        // Permitir deslizamiento táctil (Swipe) en celulares
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => startX = e.touches[0].clientX, {passive: true});
        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) { // Umbral de 50px
                if (diff > 0 && currentIndex < totalSlides - 1) currentIndex++;
                else if (diff < 0 && currentIndex > 0) currentIndex--;
                updateCarousel();
            }
        }, {passive: true});
    });
</script>

