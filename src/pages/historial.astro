<!-- SCRIPT COMPLETAMENTE AISLADO -->
<script>
    function inicializarEstrategiaCarrusel() {
        // Buscamos el contenedor raíz de esta sección en particular
        const root = document.getElementById('seccion-estrategia-carrusel');
        if (!root) return;

        // Buscamos los elementos del carrusel SOLO dentro de este contenedor raíz
        const slides = root.querySelectorAll('.estrategia-slide');
        const btnPrev = root.querySelector('.estrategia-btn-prev');
        const btnNext = root.querySelector('.estrategia-btn-next');
        const indicador = root.querySelector('.estrategia-text, .estrategia-indicador');
        
        if (slides.length === 0) return;

        let currentIndex = Array.from(slides).findIndex(slide => slide.getAttribute('data-active') === 'true');
        if (currentIndex === -1) currentIndex = slides.length - 1;

        function updateCarrusel() {
            slides.forEach((slide, idx) => {
                if (idx === currentIndex) {
                    slide.setAttribute('data-active', 'true');
                    slide.classList.remove('hidden');
                    slide.classList.add('block');
                    if (indicador) indicador.textContent = slide.getAttribute('data-carrera-nombre');
                } else {
                    slide.setAttribute('data-active', 'false');
                    slide.classList.remove('block');
                    slide.classList.add('hidden');
                }
            });
        }

        btnPrev?.addEventListener('click', () => {
            if (slides.length <= 1) return;
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = slides.length - 1;
            }
            updateCarrusel();
        });

        btnNext?.addEventListener('click', () => {
            if (slides.length <= 1) return;
            if (currentIndex < slides.length - 1) {
                currentIndex++;
            } else {
                currentIndex = 0;
            }
            updateCarrusel();
        });

        updateCarrusel();
    }

    // Inicialización segura para Astro
    inicializarEstrategiaCarrusel();
    document.addEventListener('astro:after-swap', inicializarEstrategiaCarrusel);
</script>


