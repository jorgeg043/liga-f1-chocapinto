{/* 🏎️ SCRIPTS DE TELEMETRÍA: Control de transiciones del Carrete con Bucle Infinito */}
<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('historial-wrapper');
        const slides = document.querySelectorAll('.historial-slide');
        const prevBtn = document.getElementById('prev-historial-btn');
        const nextBtn = document.getElementById('next-historial-btn');
        const dotsContainer = document.getElementById('historial-dots');
        
        if (!wrapper || slides.length === 0) return;
        
        let currentIndex = 0; // Arranca en 0 (que es la última fecha gracias al .reverse())
        const totalSlides = slides.length;

        // Inyectar indicadores de puntos para celulares
        if(dotsContainer) {
            dotsContainer.innerHTML = '';
            slides.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-red-600 w-4' : 'bg-zinc-800'}`;
                dotsContainer.appendChild(dot);
            });
        }

        const updateHistorialCarousel = () => {
            wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
            
            if(dotsContainer) {
                const dots = dotsContainer.querySelectorAll('div');
                dots.forEach((dot, i) => {
                    if(i === currentIndex) {
                        dot.className = 'w-2 h-2 rounded-full bg-red-600 w-4 transition-all duration-300';
                    } else {
                        dot.className = 'w-2 h-2 rounded-full bg-zinc-800 transition-all duration-300';
                    }
                });
            }
        };

        // 🛠️ LÓGICA DE BUCLE EN BOXES: Permite girar a izquierda y derecha sin trabas
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = totalSlides - 1; // Si estás en la última (0) y vas a la izquierda, salta a la fecha más vieja (final)
                }
                updateHistorialCarousel();
            });

            nextBtn.addEventListener('click', () => {
                if (currentIndex < totalSlides - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Si llegás al final y vas a la derecha, vuelve a la última fecha corrida (inicio)
                }
                updateHistorialCarousel();
            });
        }

        // Soporte Swipe táctil adaptado para bucle en mobile
        let startX = 0;
        wrapper.addEventListener('touchstart', (e) => startX = e.touches[0].clientX, {passive: true});
        wrapper.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    // Swipe a la izquierda (siguiente)
                    if (currentIndex < totalSlides - 1) currentIndex++;
                    else currentIndex = 0;
                } else {
                    // Swipe a la derecha (anterior)
                    if (currentIndex > 0) currentIndex--;
                    else currentIndex = totalSlides - 1;
                }
                updateHistorialCarousel();
            }
        }, {passive: true});
    });
</script>



