<script>
  function setupSancionesCarousel() {
    const slider = document.getElementById('sanciones-slider');
    const prevBtn = document.getElementById('prev-sancion');
    const nextBtn = document.getElementById('next-sancion');
    const dots = document.querySelectorAll('.sancion-dot');

    if (!slider || !prevBtn || !nextBtn) return;

    // Acción de las flechas
    prevBtn.onclick = () => {
      slider.scrollLeft -= slider.offsetWidth;
    };

    nextBtn.onclick = () => {
      slider.scrollLeft += slider.offsetWidth;
    };

    // Actualizar los puntitos dinámicamente al scrollear
    slider.onscroll = () => {
      const activeIndex = Math.round(slider.scrollLeft / slider.offsetWidth);
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.classList.add('!bg-red-500', 'w-4');
          dot.classList.remove('bg-zinc-700');
        } else {
          dot.classList.remove('!bg-red-500', 'w-4');
          dot.classList.add('bg-zinc-700');
        }
      });
    };
  }

  // Corremos la función respetando el ciclo de vida de Astro para que ande al ir y volver
  document.addEventListener('astro:page-load', setupSancionesCarousel);
</script>

