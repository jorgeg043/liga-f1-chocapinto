// Mantener los imports iguales arriba
import '../styles/global.css';
import pilotos from '../Data/pilotos.json';
import historial from '../Data/historial.json';
import { ClientRouter } from 'astro:transitions';
import datosTelemetria from '../Data/telemetria.json';
import sanciones from '../Data/comisario.json';

const carreraActualId = "Baku";
const ultimaFecha = 4;
const fechas = Array.from({ length: ultimaFecha }, (_, i) => ultimaFecha - i);
const carreras = [...historial].reverse();
const datosCarrera = datosTelemetria.find(c => c.carreraId === carreraActualId);
const listaPilotos = datosCarrera ? datosCarrera.pilotos : [];
const logos = {
  "Mercedes Benz": "/Fotos/logo-mercedes.png",
  "Alpine": "/Fotos/logo-alpine.png",
  "Red Bull": "/Fotos/logo-redbull.png",
  "Ferrari": "/Fotos/logo-ferrari.png",
  "Williams": "/Fotos/logo-williams.png",
  "Haas": "/Fotos/logo-haas.png",
  "Racing Bulls": "/Fotos/logo-racingbulls.png",
  "Aston Martin": "/Fotos/logo-astonmartin.png",
  "Kick Sauber": "/Fotos/logo-kicksauber.png",
  "Mclaren": "/Fotos/logo-mclaren.png",
};

const obtenerInfoPiloto = (nombre) => {
    return pilotos.find(p => p.nombre === nombre) || { escuderia: "S/D" };
};
