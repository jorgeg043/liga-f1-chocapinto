            <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                <h4 class="font-black italic uppercase text-sm tracking-wider text-red-500 flex items-center gap-2">
                    <span></span> POLE POSITIONS
                </h4>
                <span class="text-[9px] text-zinc-600 uppercase">Módulo: POL</span>
            </div>
            <div class="space-y-2">
                {rankingPoles.slice(0, 5).map((p, idx) => (
                    <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-red-500/30 transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="font-black text-zinc-600 group-hover:text-red-500">0{idx + 1}</span>
                            <span class="font-black text-white uppercase italic">{p.nombre}</span>
