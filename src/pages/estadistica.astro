---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import pilotos from '../Data/pilotos.json';
import Layout from '../layouts/Layout.astro';
import historial from '../Data/historial.json';
import sprint from '../Data/sprint.json';

// --- LÓGICA DE CONSOLIDACIÓN (Mantengo tu código igual) ---
const statsPilotos = {};
const MAX_PUNTOS_FECHA = 27;
const totalGpsLiga = Math.max(
    ...pilotos
        .filter(p => p.activo !== false)
        .map(p => p.carrerasCorridas || 0), 
    1 // Resguardo por si el torneo recién arranca y está todo en 0
);

function procesarSesion(dataArray) {
  (dataArray || []).forEach((sesion) => {
    const esNombreValido = (n) => n && typeof n === 'string' && !n.includes(':') && !/^\d/.test(n);

    const registrarPiloto = (nombre) => {
      if (esNombreValido(nombre)) {
        if (!statsPilotos[nombre]) {
          statsPilotos[nombre] = { nombre, puntos: 0, victorias: 0, podios: 0, poles: 0, vRapidas: 0 };
        }
        return true;
      }
      return false;
    };

    if (registrarPiloto(sesion.pole)) statsPilotos[sesion.pole].poles += 1;
    const vr = sesion.pilotoVueltaRapida || sesion.vueltaRapida;
    if (registrarPiloto(vr)) statsPilotos[vr].vRapidas += 1;

    if (sesion.resultados) {
      sesion.resultados.forEach((res) => {
        if (registrarPiloto(res.piloto)) {
          statsPilotos[res.piloto].puntos += (res.puntos || 0);
          if (res.pos === 1) statsPilotos[res.piloto].victorias += 1;
          if (res.pos <= 3) statsPilotos[res.piloto].podios += 1;
        }
      });
    }
  });
}

procesarSesion(historial);
procesarSesion(sprint);
// 📊 Generamos la lista base filtrando únicamente los pilotos activos de la grilla
const pilotosActivos = pilotos.filter(p => p.activo !== false && p.nombre !== "");

// --- REEMPLAZÁ TUS VARIABLES DE RANKINGS ARRIBA EN EL FRONTMATTER POR ESTAS ---

// --- REEMPLAZÁ TUS VARIABLES DE RANKINGS ARRIBA EN EL FRONTMATTER POR ESTAS ---

// Filtramos únicamente los pilotos que están en pista actualmente
const pilotosActivosParaRankings = pilotos.filter(p => p.activo !== false && p.nombre !== "");

// Ahora todos los ránkings apuntan al JSON consolidado, usando los nombres de propiedades correctos
const rankingVictorias = [...pilotosActivosParaRankings].sort((a, b) => (b.victorias || 0) - (a.victorias || 0));
const rankingPoles = [...pilotosActivosParaRankings].sort((a, b) => (b.poles || 0) - (a.poles || 0));
const rankingVR = [...pilotosActivosParaRankings].sort((a, b) => (b.vueltasRapidas || 0) - (a.vueltasRapidas || 0)); // ⚡ ¡Corregido aquí!
const rankingGPs = [...pilotosActivosParaRankings].sort((a, b) => (b.carrerasCorridas || 0) - (a.carrerasCorridas || 0));
const rankingDNF = [...pilotosActivosParaRankings].sort((a, b) => (b.dnf || 0) - (a.dnf || 0));
---
<body class="bg-slate-950 text-white font-sans">

<nav class="bg-slate-950 fixed top-0 w-full bg-[#020c1b]/95 backdrop-blur-xl border-b border-white/5 z-[100]">
    <div class="bg-slate-950 max-w-7xl mx-auto px-6 py-4 flex justify-between items-center relative">
        
        <a href="/" class="bg-slate-950 flex items-center gap-3 group cursor-pointer">
            <div class="flex flex-col items-start leading-none">
                <span class="font-black italic text-xl tracking-tighter uppercase text-white -skew-x-12">
                    FORMULA <span class="text-red-600">1</span>
                </span>
                <span class="text-[7px] font-mono text-zinc-500 uppercase tracking-[0.4em] ml-1">Statistics Center</span>
            </div>
        </a>

        <div class="hidden md:flex items-center gap-6 text-[11px] font-black uppercase tracking-[0.2em]">
            <a href="/" class="text-zinc-400 hover:text-white transition-all flex items-center gap-2 group/link">
                <span class="w-1 h-1 bg-zinc-800 group-hover:bg-red-600 rounded-full transition-colors"></span>
                Inicio
            </a>
            <a href="/historial" class="text-zinc-400 hover:text-white transition-all flex items-center gap-2 group/link">
                <span class="w-1 h-1 bg-zinc-800 group-hover:bg-red-600 rounded-full transition-colors"></span>
                Historial Carreras
            </a>
            <a href="/sprint" class="text-zinc-400 hover:text-white transition-all flex items-center gap-2 group/link">
                <span class="w-1 h-1 bg-zinc-800 group-hover:bg-red-600 rounded-full transition-colors"></span>
                Sprint
            </a>
            
            <div class="bg-red-600/10 border border-red-600/30 px-4 py-2 rounded-md">
                <span class="text-red-500 font-black italic">Stats Mode Active</span>
            </div>
        </div>

        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 items-end group outline-none">
            <span class="w-8 h-[2px] bg-white group-hover:bg-red-600 transition-all origin-right" id="line1"></span>
            <span class="w-5 h-[2px] bg-red-600 group-hover:bg-white transition-all" id="line2"></span>
            <span class="w-8 h-[2px] bg-white group-hover:bg-red-600 transition-all origin-right" id="line3"></span>
        </button>
    </div>

    <div id="mobile-menu-content" class="bg-slate-950 fixed inset-0 top-[72px] bg-[#020c1b] z-[90] flex flex-col p-8 transition-all duration-500 translate-x-full md:hidden">
        <div class="flex flex-col gap-8">
            <span class="text-[9px] font-mono text-zinc-600 tracking-[0.5em] uppercase border-b border-zinc-900 pb-2">Analytics System</span>
            
            <a href="/" class="mobile-link text-4xl font-black italic uppercase text-white tracking-tighter">Inicio</a>
            <a href="/historial" class="mobile-link text-4xl font-black italic uppercase text-white tracking-tighter">Historial</a>
            <a href="/sprint" class="mobile-link text-4xl font-black italic uppercase text-white tracking-tighter">Sprint</a>
            
            <div class="bg-slate-950 mt-4 p-4 border-l-2 border-red-600 bg-red-600/5">
                <span class="text-[10px] font-mono text-red-500 uppercase tracking-widest block mb-1">Current Task:</span>
                <span class="text-xl font-black text-white italic uppercase">Global Statistics</span>
            </div>
        </div>
        <div class="mt-auto opacity-10">
            <span class="text-[60px] font-black italic text-white leading-none tracking-tighter">ANALYTICS</span>
        </div>
    </div>
</nav>

<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu-content');
        const lines = [document.getElementById('line1'), document.getElementById('line2'), document.getElementById('line3')];

        if (!btn || !menu) return;

        const toggleMenu = () => {
            const isOpen = menu.classList.contains('translate-x-0');
            if (isOpen) {
                menu.classList.remove('translate-x-0');
                menu.classList.add('translate-x-full');
                lines[0].style.transform = 'rotate(0) translateY(0)';
                lines[1].style.opacity = '1';
                lines[2].style.transform = 'rotate(0) translateY(0)';
            } else {
                menu.classList.remove('translate-x-full');
                menu.classList.add('translate-x-0');
                lines[0].style.transform = 'rotate(-45deg) translate(-5px, 5px)';
                lines[1].style.opacity = '0';
                lines[2].style.transform = 'rotate(45deg) translate(-5px, -5px)';
            }
        };

        btn.addEventListener('click', toggleMenu);

        // Cerramos el menú si se hace click en un link (evita que quede abierto al volver)
        const links = document.querySelectorAll('.mobile-link');
        links.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.remove('translate-x-0');
                menu.classList.add('translate-x-full');
            });
        });
    });
</script>

  <main class="bg-slate-950 max-w-5xl mx-auto pt-32 pb-20 px-4">
    <header id="inicio" class="bg-slate-950 mb-16 relative py-20 overflow-hidden "> 
    <img 
        src="/Fotos/fondo-f1.png" 
        class="bg-slate-950 absolute inset-0 w-full h-full object-cover opacity-20 z-0 pointer-events-none" 
        alt="Fondo Sprint"
        
    />
<div class="absolute inset-0 z-[1] bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-900/0 via-black/80 to-black pointer-events-none"></div>

    <div class="absolute inset-0 z-[2] opacity-[0.03] pointer-events-none bg-[url('data:image/svg+xml;base64,')] bg-center"></div>

    <div class="absolute top-10 left-10 w-16 h-16 border-t-2 border-l-2 border-zinc-800 pointer-events-none opacity-40"></div>
    <div class="absolute top-10 right-10 w-16 h-16 border-t-2 border-r-2 border-zinc-800 pointer-events-none opacity-40"></div>
    <div class="relative z-10 text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black uppercase italic tracking-tighter text-white -skew-x-15 leading-tight">
            ESTADISTICAS 
            <span class="block md:inline text-red-600 -skew-x-15 drop-shadow-[0_0_20px_rgba(220,38,38,0.6)]">
                PILOTOS
            </span>
        </h1>
        <div class="mt-8 mb-4 flex justify-center items-center gap-4 reveal-on-scroll">
            <span class="flex-1 h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent max-w-[200px]"></span>
            
                
                
            </div>
            <span class="flex-1 h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent max-w-[200px]"></span>
        </div>
    </div>
    <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-red-950 via-red-600 to-red-950 opacity-80 shadow-[0_0_20px_rgba(220,38,38,0.5)]"></div>
</header>
<section id="estadisticas-excel" class="mb-20 scroll-mt-32 max-w-7xl mx-auto px-4">
    <div class="reveal-on-scroll text-center mb-12">
        <h2 class="text-sm font-black mb-4 uppercase tracking-[0.4em] text-zinc-500">
            Telemetria <span class="text-red-600">Global</span> Rendimiento
        </h2>
        <h3 class="text-4xl font-black uppercase italic text-white tracking-tighter">
            DATOS DE EFICIENCIA <span class="text-red-600">ABSOLUTA</span>
        </h3>
        <p class="text-zinc-500 font-mono text-[10px] uppercase tracking-widest mt-2">
            Computo en base a <span class="text-white bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">{totalGpsLiga} GPs Totales</span> disputados por la Liga
        </p>
    </div>

    {/* Contenedor HUD tipo Matriz Excel */}
    <div class="bg-zinc-950/50 backdrop-blur-md rounded-xl overflow-hidden border border-zinc-900 shadow-2xl">
        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left border-collapse font-mono text-xs">
                
                <thead class="bg-zinc-900/90 border-b border-zinc-800 text-zinc-400 font-black uppercase tracking-wider">
                    <tr>
                        <th class="px-4 py-4 text-center w-12 bg-zinc-950/40 border-r border-zinc-900 text-red-500">#</th>
                        <th class="px-6 py-4 text-left min-w-[200px]">Piloto / Escuderia</th>
                        <th class="px-4 py-4 text-center text-yellow-500 border-l border-zinc-900/60">VIC</th>
                        <th class="px-4 py-4 text-center text-red-500">POL</th>
                        <th class="px-4 py-4 text-center text-blue-400">V.R.</th>
                        <th class="px-4 py-4 text-center text-orange-400">DNF</th>
                        <th class="px-4 py-4 text-center text-zinc-400">GPs CORRIDOS</th>
                        <th class="px-6 py-4 text-right text-white bg-zinc-900 border-l border-zinc-900/60">TOTAL PTS</th>
                        <th class="px-6 py-4 text-right text-green-400 bg-zinc-900/40 border-l-2 border-zinc-800">EFICIENCIA REAL</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-zinc-900">
                    {(() => {
                        const pilotosEstadistica = pilotos
                            .filter(p => p.activo !== false && p.nombre !== "")
                            .map(p => {
                                const carrerasPiloto = p.carrerasCorridas || 0;
                                const abandonos = p.dnf || 0;
                                
                                // 📐 CÁLCULO DE RENDIMIENTO DE CAMPEONATO ABSOLUTO
                                // Dividimos los puntos por el potencial máximo de la LIGA hasta hoy
                                const puntosMaximosPosiblesLiga = totalGpsLiga * MAX_PUNTOS_FECHA;
                                const eficienciaAbsoluta = (p.puntos / puntosMaximosPosiblesLiga) * 100;

                                return {
                                    ...p,
                                    carrerasCorridas: carrerasPiloto,
                                    dnf: abandonos,
                                    eficienciaCalculada: eficienciaAbsoluta
                                };
                            })
                            .sort((a, b) => b.eficienciaCalculada - a.eficienciaCalculada);

                        return pilotosEstadistica.map((p, idx) => {
                            const rank = idx + 1;
                            
                            return (
                                <tr class="group hover:bg-white/[0.02] transition-colors duration-200">
                                    <td class="px-4 py-4 text-center font-black bg-zinc-950/20 border-r border-zinc-900 text-zinc-600 group-hover:text-red-500 transition-colors">
                                        {rank < 10 ? `0${rank}` : rank}
                                    </td>

                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <img 
                                                src={`/Fotos/perfil-${p.nombre.toLowerCase()}.jpg`} 
                                                alt={p.nombre} 
                                                class="w-8 h-8 rounded-full object-cover border border-zinc-800 group-hover:border-zinc-600 transition-all"
                                                loading="lazy"
                                            />
                                            <div class="leading-none">
                                                <span class="font-black text-white text-sm uppercase tracking-tighter italic">
                                                    {p.nombre}
                                                </span>
                                                <span class="block text-[9px] text-zinc-500 uppercase tracking-widest mt-0.5">
                                                    {p.escuderia}
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class={`px-4 py-4 text-center font-black border-l border-zinc-900/60 ${p.victorias > 0 ? 'text-yellow-500' : 'text-zinc-700'}`}>
                                        {p.victorias}
                                    </td>
                                    <td class={`px-4 py-4 text-center font-black ${p.poles > 0 ? 'text-red-500' : 'text-zinc-700'}`}>
                                        {p.poles}
                                    </td>
                                    <td class={`px-4 py-4 text-center font-black ${p.vueltasRapidas > 0 ? 'text-blue-400' : 'text-zinc-700'}`}>
                                        {p.vueltasRapidas}
                                    </td>
                                    <td class={`px-4 py-4 text-center font-black ${p.dnf > 0 ? 'text-orange-500' : 'text-zinc-700'}`}>
                                        {p.dnf}
                                    </td>
                                    
                                    {/* Muestra cuántas corrió él de las totales de la liga */}
                                    <td class="px-4 py-4 text-center font-bold text-zinc-400">
                                        {p.carrerasCorridas} <span class="text-[9px] text-zinc-600 font-normal">/ {totalGpsLiga}</span>
                                    </td>

                                    <td class="px-6 py-4 text-right font-black text-sm text-white bg-zinc-900/30 border-l border-zinc-900/60">
                                        {p.puntos} <span class="text-[8px] text-zinc-600 font-normal">PTS</span>
                                    </td>

                                    <td class="px-6 py-4 text-right font-black text-sm bg-zinc-900/10 border-l-2 border-zinc-800 text-green-400">
                                        <div class="flex flex-col items-end leading-none">
                                            <span>{p.eficienciaCalculada.toFixed(2)}%</span>
                                            
                                            <div class="w-16 h-1 bg-zinc-900 rounded-full mt-1.5 overflow-hidden hidden sm:block border border-zinc-800">
                                                <div 
                                                    class="h-full bg-gradient-to-r from-green-600 to-green-400" 
                                                    style={`width: ${Math.min(p.eficienciaCalculada, 100)}%`}
                                                ></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            );
                        });
                    })()}
                </tbody>
            </table>
        </div>

        
    </div>
</section>


{/* ===================================================================================
    🏎️ SECCIÓN HALL OF FAME CERRADA Y CONFIGURADA (HTML LIMPIO SIN SCRIPTS INTERNOS)
    =================================================================================== */}
<section id="rankings-especialidad" class="mt-24 max-w-xl mx-auto px-4 pb-20 font-mono relative">
    
    <div class="w-full mb-8 flex flex-col justify-center items-center gap-6">
        <div class="text-center">
            <h2 class="text-sm font-black mb-2 uppercase tracking-[0.4em] text-zinc-500">
                Hall of fame <span class="text-red-600">Especialidades</span> Torneo
            </h2>
