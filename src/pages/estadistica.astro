            <button onclick="window.switchearTablaEspecialidad(3)" class="tab-especialidad bg-zinc-900 hover:bg-zinc-800 text-zinc-400 font-black uppercase italic text-[10px] px-3 py-2 rounded-lg border border-zinc-800 transition-all cursor-pointer">GPs</button>
            <button onclick="window.switchearTablaEspecialidad(4)" class="tab-especialidad bg-zinc-900 hover:bg-zinc-800 text-zinc-400 font-black uppercase italic text-[10px] px-3 py-2 rounded-lg border border-zinc-800 transition-all cursor-pointer">DNF</button>
        </div>
    </div>

   {/* Contenedor Único Estricto */}
    <div class="w-full relative text-xs z-10">

        {/* 🏆 LISTA 1: VICTORIAS */}
        <div class="card-ranking-tab block bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
            
            {/* Imagen PNG de fondo: Trofeo */}
            <img 
                src="/images/trofeo.png" 
                alt="Fondo Trofeo" 
                class="absolute inset-0 w-full h-full opacity-[0.2] pointer-events-none "
            />

            <div class="relative z-10">
                <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                    <h4 class="font-black italic uppercase text-sm tracking-wider text-yellow-500 flex items-center gap-2">
                        VICTORIAS
                    </h4>
                    
                </div>
                <div class="space-y-2 text-xs">
                    {rankingVictorias.slice(0, 5).map((p, idx) => (
                        <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-yellow-500/30 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="font-black text-zinc-600">0{idx + 1}</span>
                                <span class="font-black text-white uppercase italic">{p.nombre}</span>
                            </div>
                            <span class="font-black text-yellow-500 text-sm">{p.victorias || 0}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        {/* ⏱️ LISTA 2: POLE POSITIONS */}
        <div class="card-ranking-tab hidden bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
            
            {/* Imagen PNG de fondo: Cronómetro */}
            <img 
                src="/images/cronometro.jpg" 
                alt="Fondo Pole" 
                class="absolute inset-0 w-full h-full  opacity-[0.3] pointer-events-none "
            />

            <div class="relative z-10">
                <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                    <h4 class="font-black italic uppercase text-sm tracking-wider text-red-500 flex items-center gap-2">
                        POLE POSITIONS
                    </h4>
                   
                </div>
                <div class="space-y-2 text-xs">
                    {rankingPoles.slice(0, 5).map((p, idx) => (
                        <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-red-500/30 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="font-black text-zinc-600">0{idx + 1}</span>
                                <span class="font-black text-white uppercase italic">{p.nombre}</span>
                            </div>
                            <span class="font-black text-red-500 text-sm">{p.poles || 0}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        {/* ⚡ LISTA 3: VUELTAS RÁPIDAS */}
        <div class="card-ranking-tab hidden bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
            
            {/* Imagen PNG de fondo: Rayo o Casco */}
            <img 
                src="/images/rayo.jpg" 
                alt="Fondo VR" 
                class="absolute inset-0 w-full h-full  opacity-[0.3] pointer-events-none "
            />

            <div class="relative z-10">
                <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                    <h4 class="font-black italic uppercase text-sm tracking-wider text-blue-400 flex items-center gap-2">
                        VUELTAS RAPIDAS
                    </h4>
                    
                </div>
                <div class="space-y-2 text-xs">
                    {rankingVR.slice(0, 5).map((p, idx) => (
                        <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-blue-400/30 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="font-black text-zinc-600">0{idx + 1}</span>
                                <span class="font-black text-white uppercase italic">{p.nombre}</span>
                            </div>
                            <span class="font-black text-blue-400 text-sm">{p.vueltasRapidas || 0}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        {/* 🚦 LISTA 4: GPs CORRIDOS */}
        <div class="card-ranking-tab hidden bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
            
            {/* Imagen PNG de fondo: Neumático o Semáforo */}
            <img 
                src="/images/semaforo.jpg" 
                alt="Fondo GPs" 
                class="absolute inset-0 w-full h-full opacity-[0.2] pointer-events-none"
            />

            <div class="relative z-10">
                <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                    <h4 class="font-black italic uppercase text-sm tracking-wider text-zinc-400 flex items-center gap-2">
                        GPs CORRIDOS
                    </h4>
                    
                </div>
                <div class="space-y-2 text-xs">
                    {rankingGPs.slice(0, 5).map((p, idx) => (
                        <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-zinc-400/30 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="font-black text-zinc-600">0{idx + 1}</span>
                                <span class="font-black text-white uppercase italic">{p.nombre}</span>
                            </div>
                            <span class="font-black text-zinc-300 text-sm">{p.carrerasCorridas || 0}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        {/* 💥 LISTA 5: ABANDONOS (DNF) */}
        <div class="card-ranking-tab hidden bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
            
            {/* Imagen PNG de fondo: Alerta de Choque */}
            <img 
                src="/images/alerta.jpg" 
                alt="Fondo DNF" 
                class="absolute inset-0 w-full h-full  opacity-[0.3] pointer-events-none "
            />

            <div class="relative z-10">
                <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                    <h4 class="font-black italic uppercase text-sm tracking-wider text-orange-500 flex items-center gap-2">
                        ABANDONOS (DNF)
                    </h4>
                    <span class="text-[9px] text-zinc-600 uppercase">Módulo: DNF</span>
                </div>
                <div class="space-y-2 text-xs">
                    {rankingDNF.slice(0, 5).map((p, idx) => (
                        <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-800/40 group hover:border-orange-500/30 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="font-black text-zinc-600">0{idx + 1}</span>
                                <span class="font-black text-white uppercase italic">{p.nombre}</span>
                            </div>
                            <span class="font-black text-orange-500 text-sm">{p.dnf || 0}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

    </div>
</section>

{/* ===================================================================================
    🛠️ MOTOR GLOBAL UNIFICADO (Pégalo al final de tu archivo, abajo de todo antes de </main>)
    =================================================================================== */}
<script data-astro-rerun>
    // Inyectamos la función directamente en el objeto Window global del navegador.
    // Esto asegura que el HTML la pueda ejecutar nativamente sin importar el ciclo de Astro.
    window.switchearTablaEspecialidad = function(targetIndex) {
        const section = document.querySelector('#rankings-especialidad');
        if (!section) return;

        const tabs = section.querySelectorAll('.tab-especialidad');
        const cards = section.querySelectorAll('.card-ranking-tab');

        if (tabs.length === 0 || cards.length === 0) return;

        // 1. Alternar visualización de las tablas
        cards.forEach((card, idx) => {
            if (idx === targetIndex) {
                card.classList.remove('hidden');
                card.classList.add('block');
            } else {
                card.classList.remove('block');
                card.classList.add('hidden');
            }
        });

        // 2. Alternar estilos activos de la botonera HUD
        tabs.forEach((tab, idx) => {
            if (idx === targetIndex) {
                tab.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
                tab.classList.add('bg-red-600', 'text-white', 'border-red-500/20');
            } else {
                tab.classList.remove('bg-red-600', 'text-white', 'border-red-500/20');
                tab.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
            }
        });
    };
</script>
  
  </main>
</Layout>
</body>