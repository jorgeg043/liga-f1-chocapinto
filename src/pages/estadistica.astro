                <h4 class="font-black italic uppercase text-sm tracking-wider text-zinc-400 flex items-center gap-2">
                    <span> </span> GPs CORRIDOS
                </h4>
                <span class="text-[9px] text-zinc-600 uppercase">Módulo: EXP</span>
            </div>
            <div class="space-y-2">
                {rankingGPs.slice(0, 5).map((p, idx) => (
                    <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-900/40 group hover:border-zinc-400/30 transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="font-black text-zinc-600 group-hover:text-zinc-300">0{idx + 1}</span>
                            <span class="font-black text-white uppercase italic">{p.nombre}</span>
                        </div>
                        <span class="font-black text-zinc-300 text-sm">{p.carrerasCorridas || 0}</span>
                    </div>
                ))}
            </div>
        </div>

        {/* 💥 LISTA 5: ABANDONOS (DNF) */}
        <div class="bg-zinc-950/40 border border-zinc-900 rounded-xl p-5 shadow-xl backdrop-blur-sm">
            <div class="flex items-center justify-between border-b border-zinc-900 pb-3 mb-4">
                <h4 class="font-black italic uppercase text-sm tracking-wider text-orange-500 flex items-center gap-2">
                    <span></span> ABANDONOS (DNF)
                </h4>
                <span class="text-[9px] text-zinc-600 uppercase">Módulo: DNF</span>
            </div>
            <div class="space-y-2">
                {rankingDNF.slice(0, 5).map((p, idx) => (
                    <div class="flex items-center justify-between bg-zinc-900/30 px-3 py-2.5 rounded border border-zinc-800/40 group hover:border-orange-500/30 transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="font-black text-zinc-600 group-hover:text-orange-500">0{idx + 1}</span>
                            <span class="font-black text-white uppercase italic">{p.nombre}</span>
                        </div>
                        <span class="font-black text-orange-500 text-sm">{p.dnf || 0}</span>
                    </div>
                ))}
            </div>
        </div>

    </div>
</section>

<script data-astro-rerun>
    // Función centralizada de animación
    function animarBarras() {
        // Buscamos todas las barras
        const bars = document.querySelectorAll('.f1-telemetry-bar');
        
        // Pequeño delay para que la transición de página termine y se vea el efecto "filling"
        setTimeout(() => {
            bars.forEach(bar => {
                const targetWidth = bar.getAttribute('data-p');
                if (targetWidth) {
                    bar.style.width = targetWidth + '%';
                }
            });
        }, 100); // 100ms es suficiente para que el DOM esté listo
    }

    // Se dispara en la carga inicial
    animarBarras();

    // Se dispara cada vez que Astro cambia de página (View Transitions)
    document.addEventListener('astro:page-load', animarBarras);
</script>
    

  </main>
</Layout>

<script data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
        // Animación de barras
        const bars = document.querySelectorAll('.f1-telemetry-bar');
        setTimeout(() => {
            bars.forEach(bar => {
                const val = bar.getAttribute('data-p');
                bar.style.width = val + '%';
            });
        }, 300);

        // Menú Móvil
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu-content');
        if (btn && menu) {
            btn.addEventListener('click', () => {
                const isOpen = menu.classList.contains('translate-x-0');
                menu.classList.toggle('translate-x-0', !isOpen);
                menu.classList.toggle('translate-x-full', isOpen);
            });
        }
    });
</script>
<style>
    /* Animación extra para el brillo de las barras */
    @keyframes shimmer {
        100% { transform: translateX(100%); }
    }
    
    /* Aseguramos que el contenedor de la página tenga el fondo correcto */
    
</style>

</body>